Options -Indexes -MultiViews

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Serve real files (CSS, JS, fonts, icons) directly.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    # Everything else goes through the front controller.
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|svg|png|webp|jpg|ico|webmanifest)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    # The service worker is checked for a new version on every visit.
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Compress the stylesheet, scripts and icons when Apache's mod_deflate is loaded (XAMPP ships it switched
# off; see README). Pages themselves are left uncompressed: they hold form tokens next to text people type,
# which compression can leak over HTTPS (the BREACH attack).
<IfModule mod_deflate.c>
    <FilesMatch "\.(css|js|svg|webmanifest)$">
        SetOutputFilter DEFLATE
    </FilesMatch>
</IfModule>

# PHP settings for uploads under mod_php (php.ini limits still apply).
<IfModule php_module>
    php_value upload_max_filesize 40M
    php_value post_max_size 42M
    php_flag display_errors Off
</IfModule>
