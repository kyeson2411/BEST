# Sibol configuration template. Copy to .env and adjust.
# Never commit .env. Never put real keys in this file.

# --- Application -------------------------------------------------------------
# local | production
APP_ENV=local
# Full URL of the public/ folder, no trailing slash.
APP_URL=http://localhost/BEST/public
APP_NAME=Sibol
# Default school timezone and language for new installations.
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
# Show the clearly labelled demo sign-in shortcuts on the login page.
# Only honoured when APP_ENV=local and the request comes from this computer.
APP_DEMO_LOGIN=true
# Set to true when serving over HTTPS so session cookies are marked Secure.
SESSION_SECURE_COOKIE=false
# Sign people out after this many minutes without activity.
SESSION_IDLE_MINUTES=120
# Seals two-step sign-in secrets in the database. Make one with: php bin/sibol.php key:generate
# Keep a copy apart from database backups. Changing or losing it means everyone who uses two-step
# sign-in needs it switched off (bin/sibol.php two-step:off) and set up again.
APP_KEY=

# --- School identity ------------------------------------------------------------
# Shown on the sign-in page and used to name the demo school. The seal and photograph
# are files in public/assets/school; regenerate them with: node tools/school-assets.mjs
SCHOOL_NAME="B.E.S.T. College of Polomolok"
SCHOOL_SHORT_NAME="B.E.S.T."
SCHOOL_LOCATION="Polomolok, South Cotabato"
SCHOOL_FOUNDED=1995
# Leave empty to hide the motto on the sign-in page.
SCHOOL_MOTTO="I am the Way, the Truth, the Life."

# --- Database (MySQL / MariaDB) ------------------------------------------------
# XAMPP default is root with no password. That is fine for a laptop demo only;
# create a dedicated least-privilege user for anything shared (see README).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sibol
DB_USER=root
DB_PASSWORD=
# Full path to mysqldump (or mariadb-dump) for "bin/sibol.php backup". Empty finds XAMPP's or one on the PATH.
DB_DUMP_PATH=

# --- AI provider ------------------------------------------------------------------
# demo       : no external calls. Clearly labelled, extractive answers built from
#              your class materials. Never pretends to be a live model.
# anthropic  : Claude via the Anthropic Messages API.
# openai_compatible : any OpenAI-style /chat/completions endpoint
#              (OpenAI, Groq, a local Ollama/LM Studio server, ...).
AI_PROVIDER=demo
# Server-side only. Never exposed to the browser.
AI_API_KEY=
AI_MODEL=
# Only for openai_compatible, e.g. https://api.groq.com/openai/v1
AI_BASE_URL=
AI_TIMEOUT_SECONDS=90
# Claude only. How much reasoning the model spends per answer: low | medium | high.
AI_EFFORT=medium
# Claude only. "default" lets the API answer with a fallback model when the main model
# declines a request; "off" disables this. See README > AI provider.
AI_FALLBACKS=default
# Optional cost estimate shown to administrators (USD per million tokens).
# Leave empty to show token counts only. Check your provider's current prices.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# --- Email (optional) -----------------------------------------------------------
# Leave MAIL_HOST empty to keep email off: administrators copy invitation and password links
# and share them themselves, as before. Google Workspace: MAIL_HOST=smtp.gmail.com, port 587,
# tls, a school account as MAIL_USERNAME and an app password for it as MAIL_PASSWORD (the
# account needs 2-Step Verification), or smtp-relay.gmail.com if your Workspace administrator
# set up the SMTP relay for this server. See README > Email.
MAIL_HOST=
MAIL_PORT=587
# tls (STARTTLS, usually port 587) | ssl (usually port 465) | none (a test server on this computer only)
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
# Server-side only: never shown in Sibol and never written to the logs.
MAIL_PASSWORD=
# The sender people see. With smtp.gmail.com it must be the account itself or one of its aliases.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Sibol

# --- Google sign-in (optional) --------------------------------------------------------
# "Sign in with your school Google account" for existing Sibol accounts, matched by email.
# Create a Web application OAuth client in Google Cloud (README > Google sign-in) with the
# redirect URI APP_URL/auth/google/callback. All three must be set; leave them empty to keep it off.
GOOGLE_CLIENT_ID=
# Server-side only: never shown in Sibol and never written to the logs.
GOOGLE_CLIENT_SECRET=
# Your Google Workspace domain(s), comma-separated, e.g. school.edu.ph. Other Google accounts are refused.
GOOGLE_WORKSPACE_DOMAINS=

# --- Uploads -------------------------------------------------------------------
# Maximum upload size in megabytes (also limited by php.ini upload_max_filesize).
UPLOAD_MAX_MB=20

# --- Logging -------------------------------------------------------------------
# debug | info | warning | error
LOG_LEVEL=info
