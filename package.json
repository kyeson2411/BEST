{
  "name": "sibol-dev-tooling",
  "private": true,
  "description": "Optional development tooling for Sibol: copies fonts/icons/KaTeX into public/assets and runs Playwright browser tests. The app itself needs only PHP + MySQL.",
  "scripts": {
    "assets": "node tools/vendor-assets.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/besley": "5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "katex": "0.19.0",
    "lucide-static": "1.58.0"
  }
}
